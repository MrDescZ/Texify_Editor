        private void SetGame(string clientId, string details, string state, string imageKey, string imageText)
        {
            client?.Dispose();
            client = new DiscordRpcClient(clientId);
            client.Initialize();

            client.SetPresence(new RichPresence
            {
                Details = details,
                State = state,
                Assets = new Assets
                {
                    LargeImageKey = imageKey,
                    LargeImageText = imageText
                }
            });
        }

        private async Task InitializeDiscordRPCStatus()
        {
            rpcStatusLabel.Text = "Connecting to Discord..."; 
            rpcStatusLabel.ForeColor = Color.Blue;

            await Task.Delay(500);

            if (!await IsInternetAvailable() || !IsDiscordRunning())
            {
                rpcStatusLabel.Text = "RPC: Disabled";
                rpcStatusLabel.ForeColor = Color.Red;
                return;
            }

            rpcStatusLabel.Text = "RPC: Connected";
            rpcStatusLabel.ForeColor = Color.Green;
            return;
        }

        private async Task<bool> IsInternetAvailable()
        {
            try
            {
                using var client = new TcpClient();
                var task = client.ConnectAsync("1.1.1.1", 53);
                var result = await Task.WhenAny(task, Task.Delay(1500));
                if (result != task || !client.Connected) return false;
            }
            catch { return false; }

            try
            {
                using HttpClient httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(2) };
                httpClient.DefaultRequestHeaders.CacheControl = new System.Net.Http.Headers.CacheControlHeaderValue { NoCache = true };
                HttpResponseMessage response = await httpClient.GetAsync("https://discord.com/api/v10");
                return response.IsSuccessStatusCode;
            }
            catch { return false; }
        }

        private bool IsDiscordRunning()
        {
            return Process.GetProcessesByName("Discord").Any() || Process.GetProcessesByName("discord").Any();

        }

