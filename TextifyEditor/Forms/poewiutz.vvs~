        private void RegisterPictureBox(PictureBox pb)
        {
            zoomValues[pb] = 1.0f;
            hoverStates[pb] = false;

            pb.MouseEnter += (s, e) => { hoverStates[pb] = true; fadeTimer.Start(); };
            pb.MouseLeave += (s, e) => { hoverStates[pb] = false; fadeTimer.Start(); };
            pb.Paint += PictureBox_Paint;
        }

        private async Task FakeProgress()
        {
            fakeProgressBar.Value = 0;
            fakeProgressBar.Visible = true;

            for (int i = 0; i <= 100; i++)
            {
                fakeProgressBar.Value = i;
            }

            fakeProgressBar.Visible = false;
            await Task.Delay(500);
        }

        private void fadeTimer_Tick(object sender, EventArgs e)
        {
            bool anyAnimation = false;

            foreach (var pb in zoomValues.Keys.ToList())
            {
                float targetScale = hoverStates[pb] ? 1.2f : 1.0f;
                float current = zoomValues[pb];
                float newScale = current + (targetScale - current) * 0.2f; // smooth ease

                if (Math.Abs(newScale - current) > 0.001f)
                {
                    zoomValues[pb] = newScale;
                    anyAnimation = true;
                    pb.Invalidate();
                }
            }

            if (!anyAnimation)
                fadeTimer.Stop();
        }


        private void PictureBox_Paint(object sender, PaintEventArgs e)
        {
            PictureBox pb = sender as PictureBox;
            float scale = zoomValues[pb];

            if (pb.Image != null)
            {
                int newW = (int)(pb.Width * scale);
                int newH = (int)(pb.Width * scale);
                int x = (pb.Width - newW) / 2;
                int y = (pb.Height - newH) / 2;

                e.Graphics.CompositingQuality = CompositingQuality.HighQuality;
                e.Graphics.SmoothingMode = SmoothingMode.HighQuality;
                e.Graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
                e.Graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
                e.Graphics.DrawImage(pb.Image, new Rectangle(x, y, newW, newH));
            }
        }

